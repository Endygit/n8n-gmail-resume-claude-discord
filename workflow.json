      "name": "Extract PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3360,
        -176
      ],
      "parameters": {
        "jsCode": "const src = $('Prepare Ticket File').first();\nconst key = $('List PDF Attachments').item.json.attachmentKey;\nfunction binOf(n){ try { return $(n).first().binary || {}; } catch(e){ return {}; } }\nconst allBin = Object.assign({}, binOf('New Devis Email'), binOf('New Devis Email Archive'), (src.binary || {}));\nconst b = allBin[key];\nif (!b) return [];\nreturn [{ json: { fileName: $('List PDF Attachments').item.json.fileName }, binary: { data: b } }];"
      }
