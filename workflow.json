    {
      "id": "0465d184-4dd9-43bb-b8b6-7625e1fdbad4",
      "name": "List PDF Attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        192
      ],
      "parameters": {
        "jsCode": "const src = $('Prepare Ticket File').first();\nconst json = src.json;\nfunction binOf(n){ try { return $(n).first().binary || {}; } catch(e){ return {}; } }\nconst bin = Object.assign({}, binOf('New Devis Email'), binOf('New Devis Email Archive'), (src.binary || {}));\nconst base = (json.datePrefix + '_' + json.senderName + '_' + json.subjectClean).substring(0, 80);\nconst out = [];\nfor (const key of Object.keys(bin)) {\n  const b = bin[key];\n  const orig = b.fileName || key;\n  const isPdf = b.mimeType === 'application/pdf' || orig.toLowerCase().endsWith('.pdf');\n  if (!isPdf) continue;\n  out.push({ json: { fileName: base + '_' + orig.replace(/[^\\w\\-.]+/g, '_'), attachmentKey: key, originalName: orig } });\n}\nif (out.length === 0) return [{ json: { noPdf: true, attachmentKeys: Object.keys(bin), attachmentTypes: Object.keys(bin).map(k => (bin[k].mimeType || '?') + ':' + (bin[k].fileName || k)) } }];\nreturn out;"
      }
    },
