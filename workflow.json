        "assignments": {
          "assignments": [
            {
              "id": "date-prefix",
              "name": "datePrefix",
              "type": "string",
              "value": "={{ (new Date($json.date || Date.now()).toISOString().substring(0, 10)) }}"
            },
            {
              "id": "sender-name",
              "name": "senderName",
              "type": "string",
              "value": "={{ (($json.from?.value?.[0] && ($json.from.value[0].name || $json.from.value[0].address)) || (typeof $json.from === 'string' ? $json.from : 'unknown')).replace(/<[^>]*>/g, '').replace(/[^\\w\\-]+/g, '_') }}"
            },
            {
              "id": "subject-clean",
              "name": "subjectClean",
              "type": "string",
              "value": "={{ ((typeof $json.subject === 'string' ? $json.subject : ($json.subject?.text || 'no-subject'))).replace(/[^\\w\\-]+/g, '_').substring(0, 60) }}"
            },
            {
              "id": "month-folder",
              "name": "monthFolder",
              "type": "string",
              "value": "={{ (new Date($json.date || Date.now()).toISOString().substring(0, 7)) }}"
            }
          ]
        },
        "options": {}
      }
